# Copy to .env.local. Server-side only, never NEXT_PUBLIC_: the backend origin that /api/* is proxied to, so the
# browser stays same-origin and the HTTP-only refresh cookie is first-party. Required by `next build` and
# `next start` (the build fails without it); `next dev` falls back to http://localhost:4000.
API_PROXY_TARGET=http://localhost:4000
